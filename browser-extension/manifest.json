{
  "manifest_version": 3,
  "name": "CPS Universal Downloader Extension",
  "version": "3.6.0",
  "description": "Download supported web video and Telegram Web media with CPS Universal Downloader Premium.",
  "permissions": ["activeTab", "contextMenus", "storage", "scripting"],
  "host_permissions": ["http://127.0.0.1:38473/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "CPS Universal Downloader", "default_icon": { "512": "icons/icon512.png" } },
  "icons": { "512": "icons/icon512.png" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://web.telegram.org/*", "https://webk.telegram.org/*", "https://webz.telegram.org/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://web.telegram.org/*", "https://webk.telegram.org/*", "https://webz.telegram.org/*"],
      "js": ["telegram-content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
